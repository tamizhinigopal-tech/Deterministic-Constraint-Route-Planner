# Database Configuration
# For PostgreSQL: postgresql://user:password@localhost:5432/dynos
# For SQLite (default): sqlite:///./dynos.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/dynos

# AI Provider Configuration
# Options: mock, claude
AI_PROVIDER=mock

# Anthropic API Key (Required if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_api_key_here
